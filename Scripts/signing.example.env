# Copy to Scripts/signing.local.env (gitignored) and fill in. Environment variables
# override these values.

# A name prefix or SHA-1 from `security find-identity -v -p codesigning`.
# Leave unset to pick Developer ID Application, then Apple Development, then ad hoc.
#SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"

# Bundle identifier override, e.g. for a fork (default: com.tnemec.keyflag).
#BUNDLE_ID=com.example.KeyFlag

# Keychain profile created with:
#   xcrun notarytool store-credentials KeyFlag --apple-id you@example.com --team-id TEAMID1234
#NOTARY_PROFILE=KeyFlag

# Sparkle updates. build-app.sh defaults to the project's public key; set this only for a
# fork with its own key pair (.build/artifacts/sparkle/Sparkle/bin/generate_keys).
#SPARKLE_PUBLIC_KEY=
#FEED_URL=https://raw.githubusercontent.com/kurtcz/KeyFlag/main/appcast.xml
